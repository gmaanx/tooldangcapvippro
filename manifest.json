{
  "manifest_version": 3,
  "name": "KahootHybridEngine",
  "version": "1.2.1",
  "description": "Real-time Multi-AI consensus engine for Kahoot, Wayground (Quizizz), and Highlight-Only Universal LMS & custom quizzes.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "KahootHybridEngine",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "webRequest",
    "clipboardRead",
    "offscreen"
  ],
  "host_permissions": [
    "https://kahoot.it/*",
    "https://play.kahoot.it/*",
    "https://create.kahoot.it/*",
    "https://wayground.com/*",
    "https://*.wayground.com/*",
    "https://quizizz.com/*",
    "https://*.quizizz.com/*",
    "https://joinmyquiz.com/*",
    "https://*.joinmyquiz.com/*",
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kahoot.it/*",
        "https://play.kahoot.it/*",
        "https://create.kahoot.it/*",
        "https://wayground.com/*",
        "https://*.wayground.com/*",
        "https://quizizz.com/*",
        "https://*.quizizz.com/*",
        "https://joinmyquiz.com/*",
        "https://*.joinmyquiz.com/*"
      ],
      "js": ["content/injector.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://kahoot.it/*",
        "https://play.kahoot.it/*",
        "https://create.kahoot.it/*",
        "https://wayground.com/*",
        "https://*.wayground.com/*",
        "https://quizizz.com/*",
        "https://*.quizizz.com/*",
        "https://joinmyquiz.com/*",
        "https://*.joinmyquiz.com/*"
      ],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "https://kahoot.it/*",
        "https://play.kahoot.it/*",
        "https://create.kahoot.it/*",
        "https://wayground.com/*",
        "https://*.wayground.com/*",
        "https://quizizz.com/*",
        "https://*.quizizz.com/*",
        "https://joinmyquiz.com/*",
        "https://*.joinmyquiz.com/*"
      ],
      "js": ["content/universal-lms.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ],
  "commands": {
    "scan-page-questions": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Scan and highlight quiz answers on the active LMS or custom page"
    },
    "trigger-vision-fallback": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Capture visible tab and resolve quiz answer via Vision AI"
    },
    "trigger-clipboard-vision": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Read snipped screenshot or text from Clipboard and solve quiz answer"
    }
  }
}
